  "scripts": {
    "build": "tsc -p tsconfig.json",
    "prepublishOnly": "npm run build"
  },
  "keywords": ["react-native", "expo", "ai", "gemini", "claude", "openai", "cloudflare-workers"],
  "repository": { "type": "git", "url": "git+https://github.com/anhto611/mobile-ai-gateway.git", "directory": "client" }
}
